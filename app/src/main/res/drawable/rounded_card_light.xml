<!-- res/drawable/rounded_card_light.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background -->
    <solid android:color="@color/white"/>  <!-- card background -->

    <!-- Rounded corners -->
    <corners android:radius="12dp"/>

    <!-- Padding inside the card -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>

    <!-- Border / Stroke -->
    <stroke
        android:width="1dp"
        android:color="@color/lightSkyBlue"/> <!-- soft pastel border -->
</shape>
