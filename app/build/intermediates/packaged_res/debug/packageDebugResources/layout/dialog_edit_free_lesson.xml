<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_lesson"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <EditText
            android:id="@+id/etEditLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lesson_title"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <EditText
            android:id="@+id/etEditLessonDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description"
            android:minLines="3"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <EditText
            android:id="@+id/etEditVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/video_url"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvEditCurrentMaterialName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_material_file_pdf"
        android:textStyle="italic"
        android:padding="4dp"
        android:layout_marginBottom="4dp"
        android:textColor="#333"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditChooseMaterial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_new_material_file_pdf_image_video"
        app:icon="@drawable/outline_file_present_24"
        android:layout_marginBottom="12dp"/>

    <ProgressBar
        android:id="@+id/progressBarEditUpload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvEditMaterialStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_a_file_to_replace_the_current_material"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_changes"
        android:backgroundTint="@color/pastelGreen"
        android:textColor="@color/black"
        android:padding="12dp"/>

</LinearLayout>