<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/lightSkyBlue">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_lesson"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etEditTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/lesson_title"
        android:padding="12dp"
        android:background="@drawable/card_background"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/description"
        android:padding="12dp"
        android:background="@drawable/card_background"
        android:minLines="3"
        android:gravity="top"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/video_link"
        android:padding="12dp"
        android:background="@drawable/card_background"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnEditUploadMaterial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/replace_material_pdf_img"
        android:backgroundTint="#FF9800"
        android:textColor="@color/white"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvEditFileStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_file_none"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#555"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/save_changes"
        android:textColor="@color/black"
        android:backgroundTint="@color/pastelGreen"/>

</LinearLayout>